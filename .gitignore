.venv/
__pycache__/
*.pyc
.env
# האינדקס (data/chroma) כן ב-Git, בלי LFS: הקובץ הגדול 49MB - מתחת למגבלה של GitHub (100MB)
.streamlit/secrets.toml
data/cache/
~$*

# יומן השיחות של הצ'אט (שאלות של משתמשים)
logs/

# מדרגים מקומיים (ONNX) - מורדים ל-data/models, לא נכנסים ל-Git
data/models/

# תעודות שורש לרשת עם סינון (Netspark) - לבנייה מקומית בלבד
certs/*.crt

# מסמכי PDF מהאתר - הקבצים המקוריים לא ב-Git (רק הטקסט שחולץ מהם)
data/pdf_raw/
