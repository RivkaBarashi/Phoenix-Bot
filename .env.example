# יש להעתיק את הקובץ הזה ל-.env ולשים בו את המפתחות האמיתיים.
# הקובץ .env לא נכנס ל-Git.

# --- ראשי: מודל שפה + אמבדינגים ---
# https://aistudio.google.com/apikey
# מודלי השפה משתמשים במפתח הזה בלבד (בלי סבב מפתחות). למסלול בתשלום - מחברים חשבון חיוב לפרויקט של המפתח הזה
# ב-Google, והקוד לא משתנה. LLM_GEMINI_KEY=<מספר> - מפתח ממוספר אחר במקומו (למשל לפיתוח).
GEMINI_API_KEY=
# מפתחות נוספים - רק לווקטור של השאלה (embeddings), כגיבוי: מפתח נכשל - הבא בתור. בדוחות מופיע מספר המפתח בלבד.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_API_KEY_11=

# --- גיבוי למודל השפה ---
# https://console.groq.com/keys
GROQ_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- שיפור אחזור (Rerank): Cohere, ובגיבוי Voyage ---
# https://dashboard.cohere.com/api-keys  (Trial: 1,000 קריאות בחודש)
COHERE_API_KEY=
# https://dashboard.voyageai.com  (בלי כרטיס: 3 בקשות ו-10K טוקנים לדקה - הקטעים מקוצרים לחלק הרלוונטי)
VOYAGE_API_KEY=
# עם אמצעי תשלום ב-Voyage המגבלה עולה - ואז: VOYAGE_TPM=2000000, והקטעים נשלחים מלאים (ואז לכייל מחדש את הסף)
VOYAGE_TPM=10000

# --- באיזה אינדקס לחפש: gemini או voyage ---
EMBEDDER=gemini

# --- ציון Rerank (Cohere) מינימלי כדי לנסות לענות. מתחת לזה: "לא מופיע באתר" ---
RERANK_THRESHOLD=0.82
# הסף של Voyage (סקאלה אחרת, כויל בנפרד על קובץ השאלות, 20/10)
RERANK_THRESHOLD_VOYAGE=0.65
# --- מדרג מקומי, אחרון בשרשרת (רק במחשב שהוא מותקן בו; לא בענן - ~10 שניות לשאלה על המעבד) ---
# הורדה חד-פעמית: python -m phoenix.rerank download. הסף שלו כויל בנפרד. בלי מדרג בכלל - "מצב זהיר" עם אזהרה.
LOCAL_RERANKER=bge-reranker-v2-m3
RERANK_THRESHOLD_LOCAL=0.2

# --- בדיקות ממשק הצ'אט (app.py) בלי לבזבז את המכסה של Gemini, למשל: groq,openrouter ---
# ריק = שרשרת המודלים הרגילה (Gemini קודם). משפיע רק על הממשק, לא על הבדיקות.
CHAT_LLM_PROVIDERS=

# --- 20 שניות לשאלה בצ'אט (מגבלה קשיחה) - שער המודלים (phoenix/gateway.py) ---
# לכל שלב נתיב: מודל ראשי, ואחרי "|" מודל הגיבוי מחברה אחרת (BACKUP = BACKUP_LLM). "~low" - חשיבה נמוכה.
# הראשי לבד; תקלה או HEDGE_AFTER_SECONDS בלי תשובה - כל שאר הנתיב מתחיל יחד. מפסק זרם לכל מודל.
# UNDERSTAND_ROUTE=gemini:gemini-3.8-flash, gemini:gemini-3.6-flash~low | BACKUP~low
# ANSWER_ROUTE=gemini:gemini-3.6-flash | BACKUP
# HEDGE_AFTER_SECONDS=3
# false - בזה אחר זה גם בצ'אט (מתג חירום). הבדיקות (eval) - תמיד בזה אחר זה.
PARALLEL_LLM=true
# החיפוש מתחיל במקביל להבנת השאלה (ואם הניסוח העצמאי שונה מהותית - חיפוש שני)
PARALLEL_SEARCH=true
# חשיבה נמוכה גם בשלב התשובה (בשלב ההבנה - תמיד). כבוי עד שבדיקת האיכות תראה שזה לא פוגע
ANSWER_LOW_THINKING=false

# --- אחסון קבוע ומשותף לשני האתרים בענן: יומן, משוב, מטמון תשובות מאומתות, שמירת שיחה ברענון ---
# https://console.upstash.com -> Redis -> REST API. בלי - הבוט עונה כרגיל, רק בלי לשמור.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- אופציונלי ---
# סריקת אתר מנוהלת: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
