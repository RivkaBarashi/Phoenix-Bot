# יש להעתיק את הקובץ הזה ל-.env ולשים בו את המפתחות האמיתיים.
# הקובץ .env לא נכנס ל-Git.

# --- ראשי: מודל שפה + אמבדינגים ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# מפתחות נוספים, כל אחד מחשבון ומפרויקט נפרד (מכסה יומית נפרדת לכל מודל). מכסה של מפתח נגמרה -
# אותו מודל ממשיך במפתח הבא. בדוחות מופיע מספר המפתח בלבד, לא הערך.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# --- גיבוי למודל השפה ---
# https://console.groq.com/keys
GROQ_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- שיפור אחזור (Rerank) ---
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# --- באיזה אינדקס לחפש: gemini או voyage ---
EMBEDDER=gemini

# --- ציון Rerank (Cohere) מינימלי כדי לנסות לענות. מתחת לזה: "לא מופיע באתר" ---
RERANK_THRESHOLD=0.82
# --- מדרג מקומי, כש-Cohere לא זמין (רץ על המעבד, בלי רשת). הורדה חד-פעמית: python -m phoenix.rerank download ---
# הסף שלו (סקאלה אחרת מ-Cohere, כויל בנפרד). בלי מדרג בכלל - "מצב זהיר" עם אזהרה.
LOCAL_RERANKER=bge-reranker-v2-m3
RERANK_THRESHOLD_LOCAL=0.2

# --- בדיקות ממשק הצ'אט (app.py) בלי לבזבז את המכסה של Gemini, למשל: groq,openrouter ---
# ריק = שרשרת המודלים הרגילה (Gemini קודם). משפיע רק על הממשק, לא על הבדיקות.
CHAT_LLM_PROVIDERS=

# --- בצ'אט: true - כל שאלה לשני מודלי Gemini במקביל (במפתחות שונים), התשובה הראשונה שעוברת את הבדיקות ---
# כבוי כברירת מחדל: לא קיצר זמנים במדידה, וכפול קריאות למודל. הבדיקות (eval) תמיד מודל אחד, בזה אחר זה.
PARALLEL_LLM=false

# --- אופציונלי ---
# אמבדינגים חלופיים: https://dashboard.voyageai.com
VOYAGE_API_KEY=
# סריקת אתר מנוהלת: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
